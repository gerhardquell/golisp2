# Superpowers scratch
.superpowers/

# Python cache
__pycache__/
*.pyc
*.pyo

# Go binaries (root level only)
/golisp2
/golisp2d
/golisp2-client

# Build artifacts
*.test
*.out
build/

# Go workspace
go.work
go.work.sum
.worktrees/

# Local binaries (installed to /usr/local/bin)
bin/

# Backup files
*.backup
*.bak
*.swp
*.swo
*~
*.tmp

# TLS-Zertifikate (sigoREST-Certs gehören nach /usr/local/slib/sigoREST/certs/,
# nie ins Repo. Guard verhindert versehentliches Committen privater Keys.)
certs/
*.crt
*.key
*.pem

# Temporaer: Builds, Test-Scripts, Server-Logs
/tmp/

# Claude-Code-Worktrees: Arbeitsverzeichnisse, nie ins Repo. Ein
# versehentliches `git add .` hat sie einmal als konfigurationslosen
# Gitlink (Modus 160000) committet — ohne .gitmodules unauflösbar.
.claude/worktrees/
