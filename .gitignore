# Python cache
__pycache__/
*.pyc
*.pyo

# Go binaries (root level only)
/golisp
/golispd
/golisp-client

# Build artifacts
*.test
*.out
build/

# Go workspace
go.work
go.work.sum
.worktrees/

# Local binaries (installed to /usr/local/bin)
bin/

